{
    "version": 2,
    "builds": [
      {
        "src": "server.js", 
        "use": "@vercel/node"
      },
      {
        "src": "package.json",
        "use": "@vercel/static-build"
      }
    ],
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": "/server.js"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      },
      {"scripts": {
  "start": "node server.js",
  "vercel-build": "echo 'No build required'"
}}   
    ]
  }